{
    "name": "Java",
    "image": "mcr.microsoft.com/devcontainers/java:1-21-bullseye",

    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack",
                "hiteshchoudharycode.chai-theme"
            ],
            "settings": {
                "editor.fontSize": 18,
                "terminal.integrated.fontSize": 16,
                "window.zoomLevel": 2,
                "editor.formatOnSave": true
            }
        }
    }
}